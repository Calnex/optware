#!/bin/sh

# Create /live/vmlinuz and /live/initrd.img symlinks to the versioned files.

set -e

# live-build runs binary hooks from the binary/ directory, but don't rely on it
if [ -d live ] && [ -d ../chroot ]; then
	BINARY_DIR=$(pwd)
	CHROOT_DIR=$(cd ../chroot && pwd)
elif [ -d binary/live ] && [ -d chroot ]; then
	BINARY_DIR=$(cd binary && pwd)
	CHROOT_DIR=$(cd chroot && pwd)
else
	echo "ERROR: cannot locate the binary/ directory from $(pwd)" >&2
	exit 1
fi

echo "--- listing for debug"
ls -l
ls -l live
ls -l ../
ls -l ../chroot/
echo "--- done listing"

cd "$BINARY_DIR/live"

link_latest() {
	NAME="$1"
	TARGET=$(ls -1 "$NAME"-* 2>/dev/null | sort -V | tail -n1 || true)

	if [ -z "$TARGET" ]; then
		echo "$NAME-* missing from live/, copying it out of the chroot"
		SOURCE=$(ls -1 "$CHROOT_DIR/boot/$NAME"-* 2>/dev/null | sort -V | tail -n1 || true)
		if [ -z "$SOURCE" ]; then
			echo "ERROR: no $NAME-* in live/ or $CHROOT_DIR/boot/" >&2
			exit 1
		fi
		cp "$SOURCE" .
		TARGET=$(basename "$SOURCE")
	fi

	rm -f "$NAME"
	ln -s "$TARGET" "$NAME"
	echo "Created live/$NAME -> $TARGET"
}

link_latest vmlinuz
link_latest initrd.img

ls -l vmlinuz initrd.img
